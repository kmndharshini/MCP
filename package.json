{
  "name": "google-workspace-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Gmail and Google Docs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx scripts/auth-setup.ts",
    "test": "tsx --test tests/sendEmail.test.ts tests/appendToDoc.test.ts tests/auth.test.ts tests/mcpProtocol.test.ts tests/vercelEndpoint.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-docs",
    "workspace"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^18.19.76",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
