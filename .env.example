# ==============================================================================
# Google Workspace MCP Server Environment Configuration
# Copy this file to .env and fill in your values, or provide credentials.json
# ==============================================================================

# Option 1: File paths (Recommended for local desktop usage)
# Path to your downloaded Google OAuth Client credentials JSON file
GOOGLE_CREDENTIALS_PATH=credentials.json

# Path where user OAuth tokens (access & refresh tokens) will be stored
GOOGLE_TOKEN_PATH=token.json

# Option 2: Explicit OAuth Client details (Alternative if not using credentials.json)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Local port for the temporary OAuth authorization callback server
AUTH_SERVER_PORT=3000

# ==============================================================================
# Vercel Deployment Settings (Serverless Mode)
# ==============================================================================
# The long-lived refresh token obtained during local "npm run auth" (from token.json)
# GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Secret key to secure your public Vercel MCP endpoint (required for production)
# MCP_API_SECRET=your-random-secret-key-for-mcp-clients
